# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Used by API routes for inserts/uploads and by /api/admin/* to read data + sign URLs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# /admin submissions dashboard (server-only — do NOT prefix with NEXT_PUBLIC_)
ADMIN_PASSWORD=change-me
# Optional: secret used to sign the admin session cookie (defaults to one derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Optional webhook forwarding for /api/submissions
SUBMISSION_WEBHOOK_URL=
SUBMISSION_WEBHOOK_TOKEN=

# Cloudflare Turnstile spam protection (https://dash.cloudflare.com → Turnstile).
# Leave empty to disable. Local test keys that always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Daily cron (keeps Supabase awake + data retention). Any long random string.
CRON_SECRET=

# Email alert per submission via https://resend.com (optional)
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Requires a domain verified in Resend; without one, onboarding@resend.dev can only
# send to the email address of your own Resend account.
ALERT_EMAIL_FROM=
